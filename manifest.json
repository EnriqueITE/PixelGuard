{
    "manifest_version": 2,
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "version": "0.2.0",
    "homepage_url": "https://github.com/EnriqueITE/PixelGuard",
    "author": "Enrique Serrano Aparicio",
    "default_locale": "en",
    "browser_specific_settings": {
        "gecko": {
            "id": "pixel-guard@enriqueite.com",
            "strict_min_version": "115.0"
        }
    },
    "permissions": [
        "messagesRead",
        "messagesModify",
        "storage"
    ],
    "background": {
        "scripts": [
            "content/scanner.js",
            "virustotal/inventory.js",
            "virustotal/service.js",
            "virustotal/bootstrap.js",
            "background.js"
        ]
    },
    "optional_permissions": [
        "sensitiveDataUpload",
        "https://www.virustotal.com/*"
    ],
    "icons": {
        "48": "assets/icon-48.png",
        "96": "assets/icon-96.png"
    },
    "browser_action": {
        "default_title": "__MSG_extensionName__",
        "default_popup": "popup/popup.html",
        "default_icon": {
            "48": "assets/icon-48.png"
        }
    },
    "message_display_action": {
        "default_title": "__MSG_extensionName__",
        "default_popup": "popup/popup.html",
        "default_icon": {
            "48": "assets/icon-48.png"
        }
    },
    "options_ui": {
        "page": "options/options.html",
        "browser_style": true,
        "open_in_tab": true
    }
}
